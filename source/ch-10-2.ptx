      stroke="#D6336C" dash="5 4" thickness="1"/>
<line at="ball-lev2" endpoints="((-0.35,1.44),(2.7,1.44))"
      stroke="#D6336C" dash="5 4" thickness="1"/>
<line at="ball-lev3" endpoints="((-0.35,0.864),(3.25,0.864))"
      stroke="#D6336C" dash="5 4" thickness="1"/>
<parametric-curve at="ball-c0" function="b0" domain="(0,1)"
                  stroke="#56B4E9" thickness="2.5"/>
<parametric-curve at="ball-c1" function="b1" domain="(0,1)"
                  stroke="#56B4E9" thickness="2.5"/>
